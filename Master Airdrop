<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Master1 Airdrop Bot - Telegram Mining 24h</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      width: 100vw;
    }
    body {
      min-height: 100vh;
      height: 100vh;
      width: 100vw;
      background: linear-gradient(135deg, #b2fefa 0%, #0ed2f7 100%);
      font-family: 'Segoe UI', Arial, sans-serif;
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: stretch;
      box-sizing: border-box;
    }
    .ad-banner {
      width: 100vw;
      text-align: center;
      padding: 8px 0;
      background: linear-gradient(90deg,#f9d423 0,#ff4e50 100%);
      color: #fff;
      font-weight: 600;
      font-size: 1.04em;
      letter-spacing: 0.5px;
      box-shadow: 0 2px 10px #ff4e5018;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 10;
      animation: fadeIn 1.2s;
    }
    .ad-banner a { color: #ffe; text-decoration: underline; }
    .container {
      flex: 1 1 auto;
      height: 100vh;
      width: 100vw;
      max-width: none;
      max-height: none;
      box-sizing: border-box;
      margin: 0;
      padding: 60px 0 100px 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      overflow-y: auto;
      background: transparent;
      justify-content: center;
    }
    @media (max-width: 500px) {
      .container { padding: 44px 0 70px 0;}
    }
    @keyframes fadeIn {
      0% { transform: translateY(80px); opacity: 0;}
      100% { transform: translateY(0); opacity: 1;}
    }
    @keyframes pop {
      0% { transform: scale(1);}
      60% { transform: scale(1.22);}
      100% { transform: scale(1);}
    }
    .animate-pop { animation: pop 1s infinite alternate;}
    .header {
      color: #fff;
      background: linear-gradient(90deg, #0088cc 40%, #0099ff 100%);
      padding: 18px 0 18px 0;
      border-radius: 12px;
      width: 95vw;
      max-width: 440px;
      text-align: center;
      font-size: 1.25em;
      margin-bottom: 18px;
      font-weight: bold;
      letter-spacing: 1px;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      box-shadow: 0 2px 14px #1aaaff15;
    }
    .header .coin-icon {
      width: 38px;
      margin-bottom: 3px;
    }
    .header .tag {
      background: #fff;
      color: #0088cc;
      font-size: 0.85em;
      border-radius: 8px;
      padding: 3px 10px;
      margin-left: 8px;
      font-weight: 500;
      margin-top: 4px;
    }
    .balance-section {
      display: flex;
      align-items: center;
      margin-bottom: 10px;
      font-size: 1.13em;
      margin-top: 10px;
    }
    #balance {
      font-weight: bold;
      margin: 0 8px;
      color: #0099ff;
      font-size: 1.17em;
      letter-spacing: 0.5px;
    }
    .unit {
      color: #888;
      font-size: 0.98em;
    }
    #mineBtn {
      background: linear-gradient(90deg, #0088cc 50%, #00b3ff 100%);
      color: #fff;
      border: none;
      border-radius: 25px;
      padding: 15px 36px;
      font-size: 1.08em;
      margin: 20px 0 10px 0;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      outline: none;
      font-weight: bold;
      box-shadow: 0 3px 18px rgba(0,153,255,0.12);
    }
    #mineBtn:active { transform: scale(0.97);}
    #mineBtn:disabled { background: #bbb; cursor: not-allowed;}
    .timer {
      color: #f00;
      font-size: 1em;
      margin: 5px 0 0 0;
      height: 20px;
    }
    .info {
      color: #555;
      font-size: 0.98em;
      margin-top: 9px;
